---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import catalog from "../../content/ingredients.json";
import IngredientCalculator from "../../components/IngredientCalculator";
export async function getStaticPaths() {
  return (await getCollection("recipes")).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const recipe = entry.data.recipe;
const names = new Map(catalog.map((item) => [item.id, item.name]));
const labels = {
  g: "г",
  kg: "кг",
  ml: "мл",
  l: "л",
  tsp: "ч. л.",
  tbsp: "ст. л.",
  piece: "шт.",
};
const difficulty = { easy: "Легко", medium: "Помірно", hard: "Складно" };
---

<Base title={recipe.title}>
  <article class="recipe-detail">
    <p class="eyebrow">Рецепт · {difficulty[recipe.difficulty]}</p>
    <h1>{recipe.title}</h1>
    <p class="detail-status">
      {recipe.status === "unverified" ? "Ще не перевірено" : "Перевірено"}
    </p>
    <p class="lead">{recipe.description}</p>
    <dl class="recipe-meta">
      <div>
        <dt>Порції</dt>
        <dd>{recipe.servings}</dd>
      </div>
      <div>
        <dt>Підготовка</dt>
        <dd>{recipe.time.prep} хв</dd>
      </div>
      <div>
        <dt>Приготування</dt>
        <dd>{recipe.time.cook} хв</dd>
      </div>
    </dl>
    <div
      class="image-placeholder hero-image"
      role="img"
      aria-label={`Фото страви «${recipe.title}» відсутнє`}
    >
      <span class="placeholder-icon" aria-hidden="true">
        🍽️
      </span>
      <span class="visually-hidden">Фото страви наразі немає</span>
    </div>
    <section aria-labelledby="ingredients">
      <h2 id="ingredients">Інгредієнти</h2>
      <IngredientCalculator
        client:only="preact"
        slug={entry.data.slug}
        recipeName={recipe.title}
        servings={recipe.servings}
        fallbackId="static-ingredients"
        ingredients={recipe.ingredients.map((item) => ({
          id: item.ingredientId,
          name: names.get(item.ingredientId) ?? item.ingredientId,
          amount: item.amount,
        }))}
      />
      <ul class="ingredients static-ingredients" id="static-ingredients">
        {recipe.ingredients.map((item, index) => (
          <li>
            <label class="ingredient-row">
              <input
                type="checkbox"
                aria-label={`${names.get(item.ingredientId)}, інгредієнт ${index + 1}`}
              />
              <span class="ingredient-name">
                {names.get(item.ingredientId)}
              </span>
              <strong class="ingredient-amount">
                {item.amount.kind === "to-taste"
                  ? "за смаком"
                  : `${item.amount.quantity.toLocaleString("uk-UA")} ${labels[item.amount.unit]}`}
              </strong>
            </label>
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="steps">
      <h2 id="steps">Приготування</h2>
      <ol class="steps">
        {recipe.steps.map((step) => (
          <li id={step.id}>
            <span>{step.text}</span>
          </li>
        ))}
      </ol>
    </section>
    {entry.data.notes && (
      <section aria-labelledby="notes">
        <h2 id="notes">Примітки</h2>
        {entry.data.notes.split(/\n\s*\n/).map((note) => (
          <p>{note}</p>
        ))}
      </section>
    )}
  </article>
</Base>
