---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import catalog from "../content/ingredients.json";
import FavoriteButton from "../components/FavoriteButton";
const recipes = (await getCollection("recipes")).sort((a, b) =>
  a.data.recipe.title.localeCompare(b.data.recipe.title, "uk"),
);
const names = new Map(catalog.map((item) => [item.id, item.name]));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Рецепти">
  <div class="page-intro">
    <p class="eyebrow">Особиста збірка</p>
    <h1>Рецепти</h1>
    <p class="lead">
      Страви для домашньої кухні з чіткими інгредієнтами та кроками.
    </p>
  </div>
  {recipes.length === 0 ? (
    <p class="empty">Рецептів поки немає.</p>
  ) : (
    <>
      <div class="catalog-tools" hidden>
        <label class="search-label" for="recipe-search">
          Пошук за назвою або інгредієнтом
        </label>
        <input
          id="recipe-search"
          type="search"
          placeholder="Знайти рецепт"
          autocomplete="off"
        />
        <div class="filters" role="group" aria-label="Статус рецепта">
          <button type="button" data-filter="all" aria-pressed="true">
            Усі
          </button>
          <button type="button" data-filter="verified" aria-pressed="false">
            Перевірені
          </button>
          <button type="button" data-filter="unverified" aria-pressed="false">
            Не перевірені
          </button>
        </div>
      </div>
      <p class="empty" id="no-results" role="status" hidden>
        За цим запитом рецептів немає.
      </p>
      <ul class="catalog">
        {recipes.map(({ data }) => (
          <li
            data-status={data.recipe.status}
            data-search={`${data.recipe.title} ${data.recipe.ingredients.map((item) => names.get(item.ingredientId)).join(" ")}`.toLocaleLowerCase(
              "uk-UA",
            )}
          >
            <article class="recipe-card">
              <FavoriteButton
                client:load
                recipeId={data.recipe.id}
                recipeName={data.recipe.title}
              />
              <a
                class="card-link"
                href={`${base}/recipes/${data.slug}/`}
                aria-label={`Відкрити рецепт: ${data.recipe.title}`}
              >
                <span class="card-content">
                  <span class="card-title">{data.recipe.title}</span>
                  <span class="card-description">
                    {data.recipe.description}
                  </span>
                  <span class="card-meta">
                    {data.recipe.time.prep + data.recipe.time.cook} хв{" "}
                    <span aria-hidden="true">·</span> {data.recipe.servings}{" "}
                    порції
                  </span>
                  <span class="status">
                    {data.recipe.status === "unverified"
                      ? "Ще не перевірено"
                      : "Перевірено"}
                  </span>
                </span>
              </a>
            </article>
          </li>
        ))}
      </ul>
      <script is:inline>
        const tools = document.querySelector(".catalog-tools");
        const search = document.querySelector("#recipe-search");
        const cards = [...document.querySelectorAll(".catalog > li")];
        const filters = [...document.querySelectorAll("[data-filter]")];
        const empty = document.querySelector("#no-results");
        let filter = "all";
        const update = () => {
          const query = search.value.trim().toLocaleLowerCase("uk-UA");
          let shown = 0;
          for (const card of cards) {
            const match =
              (filter === "all" || card.dataset.status === filter) &&
              card.dataset.search.includes(query);
            card.hidden = !match;
            if (match) shown++;
          }
          empty.hidden = shown !== 0;
        };
        tools.hidden = false;
        search.addEventListener("input", update);
        for (const button of filters) {
          button.addEventListener("click", () => {
            filter = button.dataset.filter;
            for (const item of filters)
              item.setAttribute("aria-pressed", String(item === button));
            update();
          });
        }
      </script>
    </>
  )}
</Base>
