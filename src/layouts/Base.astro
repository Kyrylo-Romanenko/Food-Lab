---
import "../styles/global.css";
interface Props {
  title: string;
  lang?: string;
}
const { title, lang = "uk" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Особиста збірка рецептів" />
    <title>{title} · Personal Cookbook</title>
  </head>
  <body>
    <a class="skip" href="#main">
      До вмісту
    </a>
    <header>
      <a href={`${base}/`} lang="en">
        Personal Cookbook
      </a>
      <span>Особиста збірка рецептів</span>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <a href={`${base}/ai/recipe-authoring/`}>
        Інструкція для ШІ <span lang="en">(English)</span>
      </a>
      <p>Personal Cookbook — тимчасова назва.</p>
    </footer>
  </body>
</html>
