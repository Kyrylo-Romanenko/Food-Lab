---
import "../styles/global.css";
interface Props {
  title: string;
  lang?: string;
}
const { title, lang = "uk" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content="Особиста збірка рецептів" />
    <title>{title} · Personal Cookbook</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem("cookbook-theme");
        if (saved === "auto") {
          document.documentElement.removeAttribute("data-theme");
        } else if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {
        // The server-rendered dark theme remains active.
      }
    </script>
    <link rel="stylesheet" href={`${base}/design-kit/fonts.css`} />
    <link rel="stylesheet" href={`${base}/design-kit/tokens.css`} />
  </head>
  <body>
    <a class="skip" href="#main">
      До вмісту
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={`${base}/`} lang="en">
          Personal Cookbook
        </a>
        <nav aria-label="Головна навігація">
          <a
            href={`${base}/`}
            aria-current={
              Astro.url.pathname === `${base}/` ? "page" : undefined
            }
          >
            Рецепти
          </a>
        </nav>
        <button
          class="theme-toggle"
          type="button"
          aria-label="Тема: темна"
          title="Тема: темна"
          hidden
        >
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 3a9 9 0 0 0 0 18"></path>
          </svg>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <a href={`${base}/ai/recipe-authoring/`}>
        Інструкція для ШІ <span lang="en">(English)</span>
      </a>
    </footer>
    <script is:inline>
      const toggle = document.querySelector(".theme-toggle");
      const currentTheme = () =>
        document.documentElement.dataset.theme || "auto";
      const icons = {
        dark: '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg>',
        light:
          '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>',
        auto: '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v18a9 9 0 0 1 0-18Z" fill="currentColor" stroke="none"/></svg>',
      };
      const updateLabel = () => {
        const mode = currentTheme();
        const labels = {
          dark: "Тема: темна",
          light: "Тема: світла",
          auto: "Тема: авто",
        };
        const label = labels[mode];
        toggle.setAttribute("aria-label", label);
        toggle.setAttribute("title", label);
        toggle.innerHTML = icons[mode];
      };
      toggle.hidden = false;
      updateLabel();
      toggle.addEventListener("click", () => {
        const next = { dark: "light", light: "auto", auto: "dark" }[
          currentTheme()
        ];
        if (next === "auto") {
          document.documentElement.removeAttribute("data-theme");
        } else {
          document.documentElement.dataset.theme = next;
        }
        try {
          localStorage.setItem("cookbook-theme", next);
        } catch {
          // The selected theme still works for this page.
        }
        updateLabel();
      });
    </script>
  </body>
</html>
