{
  "name": "food-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "node --import ./scripts/no-telemetry.mjs ./node_modules/astro/bin/astro.mjs dev",
    "build": "node --import ./scripts/no-telemetry.mjs ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --import ./scripts/no-telemetry.mjs ./node_modules/astro/bin/astro.mjs preview",
    "check": "node --import ./scripts/no-telemetry.mjs ./node_modules/astro/bin/astro.mjs check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test:run && npm run build && node scripts/check-output.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.2",
    "astro": "7.4.7",
    "preact": "11.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "1.3.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
